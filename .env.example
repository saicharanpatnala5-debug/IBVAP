# =========================================================================
# IBVAP - Tactical Environment Configuration Specification
# Copy to .env and adjust credentials prior to production deployment
# =========================================================================

# 1. CORE PLATFORM IDENTITY
PROJECT_NAME="IBVAP - Intelligent Border Video Analytics Platform"
VERSION="2.0.0-SIH2026"
ENVIRONMENT="production"
DEBUG=false

# 2. CRYPTOGRAPHY & AUTHENTICATION (PBKDF2-HMAC-SHA256 & JWT)
SECRET_KEY="replace_with_64_character_cryptographically_secure_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. DATABASE CONFIGURATION (SQLite WAL for BOP Edge / Postgres for Central HQ)
# Central HQ: postgresql+asyncpg://ibvap_admin:SecurePassword@localhost:5432/ibvap
# BOP Outpost: sqlite+aiosqlite:///./ibvap.db
DATABASE_URL="sqlite+aiosqlite:///./ibvap.db"
REDIS_URL="redis://:RedisTacticalPass2026!@localhost:6379/0"

# 4. CONTEXT-AWARE RISK ENGINE WEIGHTS (Must total 110 calibrated basis)
WEIGHT_ZONE_INTRUSION=30
WEIGHT_NIGHT_CONTEXT=15
WEIGHT_LOITERING=15
WEIGHT_INWARD_DIRECTION=20
WEIGHT_UNKNOWN_VEHICLE=20
WEIGHT_MULTIPLE_OBJECTS=10

# 5. STORAGE & TAMPER-EVIDENT EVIDENCE
STORAGE_DIR="./storage"
SNAPSHOTS_DIR="./storage/snapshots"
CLIPS_DIR="./storage/evidence"
OFFLINE_BUFFER_DIR="./storage/buffer"
RETENTION_DAYS_EVIDENCE=90
RETENTION_DAYS_AUDIT=365

# 6. RTSP & CAMERA STREAM INGESTION
RTSP_RECONNECT_MAX_RETRIES=5
RTSP_RECONNECT_BACKOFF_SECONDS=3.0
STREAM_HEARTBEAT_INTERVAL=5.0
CAMERA_HEALTH_CHECK_INTERVAL=10.0
SYNTHETIC_STREAM_FALLBACK=true

# 7. FORWARD BORDER OUTPOST (EDGE AIR-GAP MODE)
EDGE_MODE=false
EDGE_NODE_ID="BOP-ALPHA-NODE-01"
EDGE_SITE="Indo-Nepal-Sector-B"
EDGE_BUFFER_CAPACITY=50000
OFFLINE_SYNC_INTERVAL=30.0

# 8. OBSERVABILITY & TELEMETRY
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=9090
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://127.0.0.1:3000"]
